{
  "name": "micromarket-exchange",
  "version": "1.0.0",
  "description": "B2B Agricultural Microingredient Marketplace",
  "main": "server.ts",
  "scripts": {
    "build:client": "esbuild views/client.tsx --bundle --format=iife --platform=browser --jsx=automatic --minify --outfile=public/js/app.js",
    "build:server": "esbuild server.ts --bundle --platform=node --packages=external --format=cjs --jsx=automatic --outfile=dist/server.cjs",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server.cjs",
    "dev": "tsx watch server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "esbuild": "^0.25.5",
    "express": "^4.19.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "qs": "^6.16.1"
  }
}
