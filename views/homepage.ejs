<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MicroMarket Exchange</title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/homepage.css">
  <script src="/js/main.js" defer></script>
</head>
<body>
  
<%- include('partials/header') %>


   <!-- Hero -->
    <section class="hero">
      <img src="/images/ag-warehouse.jpg" alt="Photo of the inside of a large agricultural warehouse. Lots of rows of stacked canvas bags.">
      <div class="hero-bg"></div>
      <div class="hero-content">
        <div class="hero-text">
          <h1>Where obsolete and overstock inventory finds a home.</h1>
          <h3>Connecting unicorn ingredient havers to unicorn ingredient needers.</h3>
          <button class="hero-info-button">Learn More</button>
        </div>
      </div>
    </section>

    <!-- Info Cards -->
     <section class="info">

      <div class="info-grid">
        
        <div class="card-content">

          <div class="card-left">
            <div class="card-text">
              <h2>How It Works</h2>
              <h3>In four easy steps you can have your product listed for buyers across the US. MicroMarket Exchange charges a monthly subsciption and a small listing fee once your product sells.</h3>
              <button class="about-button">About Us</button>
            </div>
          </div>

          <div class="card-right">
            <img src="/images/Hay-Missouri.webp" alt="Hay bale in the forefront of a green field.">
          </div>

        </div>

        <div class="card-content">

          <div class="card-left">
            <img src="/images/Grain.jpg" alt="Hands holding unprocessed grain in front of a bag full of grain.">
          </div>

          <div class="card-right">
            <div class="card-text">
              <h2>Commitment to Quality</h2>
              <h3>Every listing includes a spec sheet, SDS, and certificate of analysis so buyers know exactly what they're getting. Quantities, packaging type, and pickup or freight details are all handled directly between buyer and seller.</h3>
              <button class="shop-button">In Stock</button>
            </div>
          </div>

        </div>

        <div class="card-content">

          <div class="card-right">
            <div class="card-text">
              <h2>Selling Requirements</h2>
              <h3>To buy or sell on MicroMarket Exchange, your operation must hold a valid FDA registration, an active state feed license, and a physical facility - no brokers or traders allowed. Every account and listing is manually reviewed before going live.</h3>
              <button class="info-button">Selling Info</button>
            </div>
          </div>
            
          <div class="card-left">
            <img src="/images/Cattle-feedlot-south-africa-beef-industry.webp" alt="Cattle eating at a large, outoor trough.">
          </div>

        </div>
        
      </div>

     </section>

     <!-- Featured Stock -->
      <section class="featured-stock">
        <div class="featured-stock-container">
          
          <h2>Current Stock</h2>

          <div class="product-grid">

            <!-- Card 1 -->
      <div class="product-card">
        <div class="card-img">
          <span class="card-badge">Auction</span>
          <img class="card-img-icon" src="/images/IMG_9098.jpeg" alt="Product photo">
        </div>
        <div class="card-body">
          <h6 class="card-category">Amino acid</h6>
          <div class="card-name">Product 1</div>
          <div class="card-seller">Genetic Feed Co.</div>
          <div class="card-meta">Location: USA &nbsp;&nbsp; Pkg: Bulk</div>
          <div class="card-price">$20.00<span> /lbs</span></div>
          <div class="card-actions">
            <button class="btn-bid">Bid Now</button>
            <button class="btn-watchlist">Add to Watchlist</button>
          </div>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="product-card">
        <div class="card-img card-img-alt">
          <span class="card-badge">Auction</span>
          <div class="card-img-icon">
            <svg viewBox="0 0 26 26" fill="none">
              <path d="M13 3C13 3 7 7.5 7 13s6 10 6 10 6-4.5 6-10S13 3 13 3z" fill="#5E9E96" opacity="0.25"/>
              <path d="M13 5v16M7.5 9.5l5.5-3.5 5.5 3.5M9.5 18l3.5 2 3.5-2" stroke="#5E9E96" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>
        <div class="card-body">
          <div class="card-category">Vitamin</div>
          <div class="card-name">Product 2</div>
          <div class="card-seller">Genetic Feed Co.</div>
          <div class="card-meta">Location: USA &nbsp;&nbsp; Pkg: Bulk</div>
          <div class="card-price">$300.00<span> /lbs</span></div>
          <div class="card-actions">
            <button class="btn-bid">Bid Now</button>
            <button class="btn-watchlist">Add to Watchlist</button>
          </div>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="product-card">
        <div class="card-img">
          <span class="card-badge">Auction</span>
          <div class="card-img-icon">
            <svg viewBox="0 0 26 26" fill="none">
              <path d="M13 3C13 3 7 7.5 7 13s6 10 6 10 6-4.5 6-10S13 3 13 3z" fill="#5E9E96" opacity="0.25"/>
              <path d="M13 5v16M7.5 9.5l5.5-3.5 5.5 3.5M9.5 18l3.5 2 3.5-2" stroke="#5E9E96" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>
        <div class="card-body">
          <div class="card-category">Mineral</div>
          <div class="card-name">Product 3</div>
          <div class="card-seller">Genetic Feed Co.</div>
          <div class="card-meta">Location: USA &nbsp;&nbsp; Pkg: Bulk</div>
          <div class="card-price">$300.00<span> /lbs</span></div>
          <div class="card-actions">
            <button class="btn-bid">Bid Now</button>
            <button class="btn-watchlist">Add to Watchlist</button>
          </div>
        </div>
      </div>

      <!-- Card 4 -->
      <div class="product-card">
        <div class="card-img card-img-alt">
          <span class="card-badge">Auction</span>
          <div class="card-img-icon">
            <svg viewBox="0 0 26 26" fill="none">
              <path d="M13 3C13 3 7 7.5 7 13s6 10 6 10 6-4.5 6-10S13 3 13 3z" fill="#5E9E96" opacity="0.25"/>
              <path d="M13 5v16M7.5 9.5l5.5-3.5 5.5 3.5M9.5 18l3.5 2 3.5-2" stroke="#5E9E96" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>
        <div class="card-body">
          <div class="card-category">Enzyme</div>
          <div class="card-name">Product 4</div>
          <div class="card-seller">Genetic Feed Co.</div>
          <div class="card-meta">Location: USA &nbsp;&nbsp; Pkg: Bulk</div>
          <div class="card-price">$30.00<span> /lbs</span></div>
          <div class="card-actions">
            <button class="btn-bid">Bid Now</button>
            <button class="btn-watchlist">Add to Watchlist</button>
          </div>
        </div>
      </div>

          </div>
        </div>
      </section>

    <%- include('partials/footer') %>

</body>
</html>