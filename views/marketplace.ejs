<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MicroMarket Exchange Store</title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/marketplace.css">
  <script src="/js/main.js" defer></script>
  </head>
<body>

<%- include('partials/header') %>

<!-- Hero -->
 <section class="hero">
  <div class="hero-bg">
    <div class="hero-content">
    <div class="hero-text">
      <h6>CURRENT STOCK</h6>
      <h1>Verified ingredients from verified sources.</h1>
      <h3>Every listing is from an FDA-licensed operation or licensed feed mill.<br>All ingredients are reviewed and approved before going live.</h3>
      <div class="hero-stats-container">
        <div class="hero-stats">
        <div class="stat">
          <h1 class="stat-number">142</h1>
          <div class="stat-label">Active Listings</div>
        </div>
        <hr>
        <div class="stat">
          <h1 class="stat-number">38</h1>
          <div class="stat-label">Verified sellers</div>
        </div>
        <hr>
        <div class="stat">
          <h1 class="stat-number">15</h1>
          <div class="stat-label">Auctions ending today</div>
        </div>
      </div>
      <button class="info-button">Learn more</button>
      </div>
  </div>
  </div>
</section>

<!-- PAGE BODY -->
<div class="page-body">

  <!-- SIDEBAR -->
  <aside class="sidebar">

    <!-- Listing Type -->
    <div class="filter-group">
      <div class="filter-label">Listing Type</div>
      <div class="filter-item">
        <label><input type="checkbox"  /> All Listings</label>
        <span class="filter-count">142</span>
      </div>
      <div class="filter-item">
        <label><input type="checkbox" /> Auctions</label>
        <span class="filter-count">115</span>
      </div>
      <div class="filter-item">
        <label><input type="checkbox" /> Fixed price</label>
        <span class="filter-count">27</span>
      </div>
    </div>

    <div class="filter-divider"></div>

    <!-- Price Range -->
    <div class="filter-group">
      <div class="filter-label">Price Range</div>
      <div class="price-row">
        <input class="price-input" type="text" placeholder="$ Min" />
        <input class="price-input" type="text" placeholder="$ Max" />
      </div>
      <button id="btn-apply">Apply</button>
      <button id="btn-clear">Clear filters</button>
    </div>

    <div class="filter-divider"></div>

    <!-- Seller State -->
    <div class="filter-group">
      <div class="filter-label">Seller State</div>
      <div class="filter-item">
        <label><input type="checkbox" /> Texas</label>
        <span class="filter-count">42</span>
      </div>
      <div class="filter-item">
        <label><input type="checkbox" /> Iowa</label>
        <span class="filter-count">29</span>
      </div>
      <div class="filter-item">
        <label><input type="checkbox" /> Kansas</label>
        <span class="filter-count">19</span>
      </div>
      <div class="filter-item">
        <label><input type="checkbox" /> Nebraska</label>
        <span class="filter-count">17</span>
      </div>
      <div class="filter-item">
        <label><input type="checkbox" /> Minnesota</label>
        <span class="filter-count">14</span>
      </div>
      <div class="filter-item">
        <label><input type="checkbox" /> California</label>
        <span class="filter-count">12</span>
      </div>
      <div class="filter-item">
        <label><input type="checkbox" /> Washington</label>
        <span class="filter-count">9</span>
      </div>
    </div>

    <div class="filter-divider"></div>

    <!-- Unit of Measure -->
    <div class="filter-group">
      <div class="filter-label">Unit of Measure</div>
      <div class="filter-item">
        <label><input type="checkbox" /> Pounds</label>
        <span class="filter-count">52</span>
      </div>
      <div class="filter-item">
        <label><input type="checkbox" /> Kilograms</label>
        <span class="filter-count">34</span>
      </div>
      <div class="filter-item">
        <label><input type="checkbox" /> Grand</label>
        <span class="filter-count">27</span>
      </div>
    </div>

  </aside>

  <!-- MAIN -->
  <main class="main">

    <!-- Results bar -->
    <div class="results-bar">
      <div class="results-count">Showing 142 listings</div>
      <div class="search-bar">
        <input id="search-input" type="text" placeholder="Search" />
        <select id="search-dropdown">
          <option>Sort by</option>
          <option>Price: Low-High</option>
          <option>Price: High-Low</option>
          <option>Ending Soon</option>
          <option>Newest</option>
        </select>
      </div>
    </div>

    <!-- Filter pills -->
    <div class="filter-tags">
      <div class="active tag">All listings ✕</div>
    </div>

    <!-- Featured card -->
    <div class="featured-card">
      <h6 class="featured-eyebrow">Featured Listing</h6>
      <div class="featured-content">
        
        <div class="featured-seller-info"> 
          <h2 class="featured-name">Lysine-L 98.5% - Grade A</h2>
          <div class="featured-small-text">
            <p class="featured-seller">Lone Star Grain Co.</p>
            <p class="seller-location">Amarillo, TX</p>
          </div>
          
        </div>
        <div class="featured-price-block">
          <h2 class="featured-price">$0.50</h2>
          <p class="featured-unit">per pound</p>
        </div> 
      </div>
      <div class="featured-actions">
        <button id="btn-watchlist">Add to Watchlist</button>
        <button id="btn-bid">Place Bid</button>
      </div>
    </div>

    <!-- Product grid -->
    <div class="product-grid">

      <!-- Card 1 -->
      <div class="product-card">
        <div class="card-badge">● Auction</div>
        <div class="card-img-wrap">
          <div class="img-placeholder img-bag">🛍️</div>
        </div>
        <div class="card-body">
          <div class="card-title">Product</div>
          <div class="card-seller">General Feed Co.</div>
          <div class="card-location">Lovelan, USA</div>
          <div class="card-meta">
            <div class="meta-item">
              <span class="meta-key">Wt:</span>
              <span class="meta-val">55lbs</span>
            </div>
            <div class="meta-item">
              <span class="meta-key">Pkg:</span>
              <span class="meta-val">Bulk</span>
            </div>
          </div>
          <div class="card-price">$100.00 <span>/ lb</span></div>
          <div class="card-actions">
            <button class="btn-bid-sm">Bid Now</button>
            <button class="btn-watchlist-sm">Add to Watchlist</button>
          </div>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="product-card">
        <div class="card-badge">● Auction</div>
