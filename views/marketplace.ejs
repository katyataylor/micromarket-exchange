<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MicroMarket Exchange Store</title>
  <link rel="stylesheet" href="/css/global.css">
  <script src="/js/main.js" defer></script>
  </head>
<body>

<%- include('partials/header') %>

<!-- Hero -->
 <section class="hero-page-body">
  <div class="store-hero-bg">
    <div class="store-hero-content">
    <div class="store-hero-text">
      <h6>CURRENT STOCK</h6>
      <div class="display">Verified ingredients from verified sources.</div>
      <h3>Every listing is from an FDA-licensed operation or licensed feed mill.<br>All ingredients are reviewed and approved before going live.</h3>
      <div class="hero-stats-container">
        <div class="hero-stats">
        <div class="stat">
          <h1 class="stat-number">142</h1>
          <div class="stat-label">Active Listings</div>
        </div>
        <hr>
        <div class="stat">
          <h1 class="stat-number">38</h1>
          <div class="stat-label">Verified sellers</div>
        </div>
        <hr>
        <div class="stat">
          <h1 class="stat-number">15</h1>
          <div class="stat-label">Auctions ending today</div>
        </div>
      </div>
      <button id="store-hero-button">Learn more</button>
      </div>
  </div>
  </div>
</section>

<!-- PAGE BODY -->
<div class="store-page-body">

  <!-- SIDEBAR -->
  <aside class="store-sidebar">

    <!-- Listing Type -->
    <div class="store-filter-group">
      <div class="store-filter-label">Listing Type</div>
      <div class="store-filter-item">
        <label><input type="store-checkbox"  /> All Listings</label>
        <span class="store-filter-count">142</span>
      </div>
      <div class="store-filter-item">
        <label><input type="store-checkbox" /> Auctions</label>
        <span class="store-filter-count">115</span>
      </div>
      <div class="store-filter-item">
        <label><input type="store-checkbox" /> Fixed price</label>
        <span class="store-filter-count">27</span>
      </div>
    </div>

    <div class="store-filter-divider"></div>

    <!-- Price Range -->
    <div class="store-filter-group">
      <div class="store-filter-label">Price Range</div>
      <div class="store-price-row">
        <input class="price-input" type="text" placeholder="$ Min" />
        <input class="price-input" type="text" placeholder="$ Max" />
      </div>
      <button id="btn-apply">Apply</button>
      <button id="btn-clear">Clear filters</button>
    </div>

    <div class="store-filter-divider"></div>

    <!-- Seller State -->
    <div class="store-filter-group">
      <div class="store-filter-label">Seller State</div>
      <div class="store-filter-item">
        <label><input type="checkbox" /> Texas</label>
        <span class="filter-count">42</span>
      </div>
      <div class="store-filter-item">
        <label><input type="checkbox" /> Iowa</label>
        <span class="filter-count">29</span>
      </div>
      <div class="store-filter-item">
        <label><input type="checkbox" /> Kansas</label>
        <span class="filter-count">19</span>
      </div>
      <div class="store-filter-item">
        <label><input type="checkbox" /> Nebraska</label>
        <span class="filter-count">17</span>
      </div>
      <div class="store-filter-item">
        <label><input type="checkbox" /> Minnesota</label>
        <span class="filter-count">14</span>
      </div>
      <div class="store-filter-item">
        <label><input type="checkbox" /> California</label>
        <span class="filter-count">12</span>
      </div>
      <div class="store-filter-item">
        <label><input type="checkbox" /> Washington</label>
        <span class="filter-count">9</span>
      </div>
    </div>

    <div class="store-filter-divider"></div>

    <!-- Unit of Measure -->
    <div class="store-filter-group">
      <div class="store-filter-label">Unit of Measure</div>
      <div class="store-filter-item">
        <label><input type="checkbox" /> Pounds</label>
        <span class="filter-count">52</span>
      </div>
      <div class="store-filter-item">
        <label><input type="checkbox" /> Kilograms</label>
        <span class="filter-count">34</span>
      </div>
      <div class="store-filter-item">
        <label><input type="checkbox" /> Grand</label>
        <span class="filter-count">27</span>
      </div>
    </div>

  </aside>

  <!-- MAIN -->
  <main class="store-main">

    <!-- Results bar -->
    <div class="store-results-bar">
      <div class="store-results-count">Showing 142 listings</div>
      <div class="store-search-bar">
        <input id="store-search-input" type="text" placeholder="Search" />
        <select id="store-search-dropdown">
          <option>Sort by</option>
          <option>Price: Low-High</option>
          <option>Price: High-Low</option>
          <option>Ending Soon</option>
          <option>Newest</option>
        </select>
      </div>
    </div>

    <!-- Filter pills -->
    <div class="store-filter-tags">
      <div class="active tag">All listings ✕</div>
    </div>

    <!-- Featured card -->
    <div class="featured-card">
      <h6 class="featured-eyebrow">Featured Listing</h6>
      <div class="featured-content">
        
        <div class="featured-seller-info"> 
          <h2 class="featured-name">Lysine-L 98.5% - Grade A</h2>
          <div class="featured-small-text">
            <p class="featured-seller">Lone Star Grain Co.</p>
            <p class="seller-location">Amarillo, TX</p>
          </div>
          
        </div>
        <div class="featured-price-block">
          <h2 class="featured-price">$0.50</h2>
          <p class="featured-unit">per pound</p>
        </div> 
      </div>
      <div class="featured-actions">
        <button id="btn-watchlist">Add to Watchlist</button>
        <button id="btn-bid">Place Bid</button>
      </div>
    </div>

    <!-- Product grid -->
    <div class="product-grid">
      <% if (listings && listings.length > 0) { %>
       <% listings.forEach(listing => { %>
      
         <%- include('partials/productCard', { item: listing}) %>
        <% }) %>
        
       <% } else { %>
         <p>No listings yet</p>
       <% } %>

    </div><!-- /grid -->

    <div class="return-top">
      <a href="#">↑ Return to Top</a>
    </div>

</div>

<!-- Footer -->
  <%- include('partials/footer') %>

</body>
</html>