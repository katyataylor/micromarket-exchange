<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign Up</title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/registration.css">
  <script src="/js/main.js" defer></script>
</head>
<body>
  <%- include('partials/header') %>
 
 <!-- Hero -->
  <section class="hero-page-body">
    <div class="store-hero-bg">
      <div class="store-hero-text">
        <h6 class="gold">account registration</h6>
        <div class="display">Join Micromarket Exchange</div>
        <div class="p2">Micromarket Exchange is a marketplace for licensed agricultural operations. 
          Choose your membership type below. Only FDA-licensed operations and licensed 
          feed mills may buy or sell. A third-party observer membership is available for 
          viewing products only.
        </div>
      </div>
    </div>
  </section>

 <div class="page-body">

  <!-- Sign in & Disclosure -->
  <div class="p2 page-text">Already have an account? <a href="account.ejs">Sign in</a></div>

  <section class="disclosure-container">
    <ul class="h4">
      <li>
      All trading accounts require verification before activation. Our team will review
      documentation and approve or follow up within 2 business days. Third-party memberships
      are approved automatically upon email confirmation.
      </li>
    </ul>
  </section>

  <!-- Membership Type -->
  <section class="w-bubble-container">

    <div class="list-item registration">
      <h2 class="blue number">1</h2>
      <div class="text-container">
        <h3>Membership type</h3>
        <div class="subp1">Select the membership that matches your operation. This determines 
          what actions you can take on Micromarket Exchange.
        </div>
      </div>
    </div>

    <hr>

    <div class="bubble-container">
      <div class="membership-type sand-bubble" tabindex="0">
        <h2>Licensed Operation</h2>
        <h4 style="color: var(--brandSoftGraphite);">FDA-licensed farms, operations, and licensed feed mills with a physical location.</h4>
        <h4 style="color: var(--textEyebrowBlue);">• List & sell products <br>
          • Bid on listings <br>
          • Full marketplace access
        </h4>
      <div class="membership-type type-tag">Trade</div>
     </div>
    
     <div class="membership-type sand-bubble" tabindex="0">
        <h2>Industry Experts</h2>
        <h4 style="color: var(--brandSoftGraphite);">Industry consultants, researchers, and observers who need marketplace visibility.</h4>
        <h4 style="color: var(--textEyebrowBlue);"> <s>• List & sell products</s> <br>
          <s>• Bid on listings</s> <br>
          • Full marketplace access
        </h4>
        <div class="membership-type type-tag">View Only</div>
      </div>
    </div>
      
  </section>

  <!-- Contact Info -->
   <section class="w-bubble-container">

    <div class="list-item registration">
      <h2 class="blue number">2</h2>
      <div class="text-container">
        <h3>Contact information</h3>
        <div class="subp1">The primary contact for this account. This person will receive all notifications.</div>
      </div>
    </div>

    <hr>

    <div class="user-inputs-container">

      <div class="input-row">
        <div class="input-column">
          <h4>First name *</h4>
          <input class="subH1 medium" type="text" placeholder="e.g. John">
        </div>

        <div class="input-column">
          <h4>Last name *</h4>
         <input class="subH1 medium" type="text" placeholder="e.g. Smith">
        </div>
      </div>

      <div class="input-row">
        <div class="input-column">
          <h4>Business email *</h4>
          <input class="subH1 medium" type="text" placeholder="you@yourcompany.com">
        </div>

        <div class="input-column">
          <h4>First name *</h4>
          <input class="subH1 medium" type="number" placeholder="(000)000-0000">
        </div>
      </div>

      <div class="subp1">Use your business email when possible - personal addresses may delay verification.</div>

      <h4>Job title/role</h4>
      <input class="subH1 medium" type="text" placeholder="e.g. Owner, Operations Manager">
    </div>
   </section>

  <!-- Business Info -->
  <section class="w-bubble-container">

    <div class="list-item registration">
      <h2 class="blue number">3</h2>
      <div class="text-container">
        <h3>Business information</h3>
        <div class="subp1">Details about your operation. Must match your FDA or state license records.</div>
      </div>
    </div>

    <hr>

    <div class="user-inputs-container">
      <h4>Business name *</h4>
      <input class="subH1 large" type="text" placeholder="As it appears on your license">

      <div class="input-row">
        <div class="input-column">
          <h4>Business type *</h4>
          <input class="subH1 medium" type="text" placeholder="Input type">
        </div>

        <div class="input-column">
          <h4>State issuing license *</h4>
          <input class="subH1 medium" type="text" placeholder="Select state">
        </div>
      </div>

      <h4>Address *</h4>
      <input class="subH1 large" type="text" placeholder="Street address">

      <div class="input-row">
        <input class="subH1" type="text" placeholder="City">
        <input class="subH1" type="text" placeholder="State">
        <input class="subH1" type="text" placeholder="ZIP code">
      </div>

      <div class="subp1">Must be a physical address. P.O. boxes are not accepted.</div>

      <h4>Website</h4>
      <input class="subH1 large" type="text" placeholder="www.yourcompany.com">
    </div>

   </section>
  <!-- License & Registration -->
   <section class="w-bubble-container">

    <div class="list-item registration">
      <h2 class="blue number">4</h2>
      <div class="text-container">
        <h3>License & registration</h3>
        <div class="subp1">Your FDA and state license details. Our team verifies all trading accounts against these records before activation.</div>
      </div>
    </div>

    <hr>

    <div class="user-inputs-container">

      <div class="input-row">

        <div class="input-column">
          <h4>FDA registration number *</h4>
          <input class="subH1 medium" type="number" placeholder="e.g. 12345678901">
          <div class="subp1">11-digit FDA Food Facility Registration number.</div>
        </div>

        <div class="input-column">
          <h4>State feed license number *</h4>
          <input class="subH1 medium" type="number" placeholder="State-issued license number">
        </div>

      </div>

      <div class="input-row">

        <div class="input-column">
          <h4>License expiry date *</h4>
          <input class="subH1 medium" type="text" placeholder="MM/YYYY">
        </div>

        <div class="input-column">
          <h4>Issuing authority</h4>
          <input class="subH1 medium" type="text" placeholder="e.g. Texas Department of Agriculture">
        </div>

      </div>

      <h4>Upload license documentation *</h4>
      <div class="user-inputs-container" id="upload-box">
        <div class="upload-box-content">
          <img src="../public/images/upload icon.png" alt="Yellow upload here icon">
          <div class="p2">Click to upload or drag and drop</div>
          <div class="tag-container">
            <div class="upload-tag eyebrow">PDF</div>
            <div class="upload-tag eyebrow">JPG</div>
            <div class="upload-tag eyebrow">PNG</div>
          </div>
        </div>
        <div class="subp1">Upload copies of your current FDA registration and state feed license. Both are required for trading accounts.</div>
      </div>
    </div>
  </section>

  <!-- Create login -->
   <section class="w-bubble-container">

    <div class="list-item registration">
      <h2 class="blue number">5</h2>
      <div class="text-container">
        <h3>Create your login</h3>
        <div class="subp1">Choose a secure password for your Micromarket Exchange account.</div>
      </div>
    </div>

    <hr>

    <div class="user-inputs-container">

      <h4>Username *</h4>
      <input class="subH1 medium" type="text" placeholder="e.g. johnsmith1">
      
      <div class="input-row">
        <div class="input-column">
          <h4>Password *</h4>
          <input class="subH1 medium" type="text" placeholder="Minimum 8 characters">
        </div>
       
        <div class="input-column">
          <h4>Confirm password *</h4>
          <input class="subH1 medium" type="text" placeholder="Re-enter password">
        </div>
      </div>

      <div class="subp1">Use at least 8 characters including a number and a symbol.</div>
    
    </div>

   </section>

  <!-- Agreements -->
   <section class="w-bubble-container">

    <div class="list-item registration">
      <h2 class="blue number">6</h2>
      <div class="text-container">
        <h3>Agreements</h3>
        <div class="subp1">Review and accept these terms before submitting your application.</div>
      </div>
    </div>

    <hr>

    <div class="user-inputs-container">

      <div class="blue-bubble registration">
        <input type="checkbox" class="blue-check" id="termsOfServiceAndPrivacy">
        <h4>I have read and agree to the Micromarket Exchange Terms of Service and Privacy Policy.</h4>
      </div>

      <div class="blue-bubble registration">
        <input type="checkbox" class="blue-check" id="licensingConfirmation">
        <h4>I certify that my operation holds a valid FDA registration and/or state feed license and that all 
          information provided is accurate. I understand that providing false information will result in 
          account termination.
        </h4>
      </div>

      <div class="blue-bubble registration">
        <input type="checkbox" class="blue-check" id="accountReview">
        <h4>I understand that my trading account must be verified by Micromarket Exchange before I can buy 
          or sell, and that Micromarket Exchange reserves the right to suspend accounts found to be operating
          outside their licensed scope.
        </h4>
      </div>
      
    </div>

   </section>
 
  <!-- Submit -->
   <section class="w-bubble-container">

    <div class="cta-text-container">
        <div class="p2">Submit your application</div>
        <div class="p2" style="color: var(--textMutedCaptions);">Trading accounts are reviewed 
          within 2 business days. You'll receive a confirmation email once approved.
        </div>
      </div>
      <button class="list-button">Save Draft</button>
      <button class="list-button">Submit</button>

   </section>


 </div>
  <%- include('partials/footer') %>
</body>
</html>